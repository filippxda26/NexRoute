#!/bin/sh
# The web server supplies the peer of this request. Never trust forwarded headers.
# No router state or other client's address is exposed.
printf 'Content-Type: application/json\r\nCache-Control: no-store\r\nX-Content-Type-Options: nosniff\r\n\r\n'
case "${REQUEST_METHOD:-}" in
  GET)
    case "${REMOTE_ADDR:-}" in
      ''|*[!0-9A-Fa-f:.]*) printf '{"ip":""}\n' ;;
      *) printf '{"ip":"%s"}\n' "$REMOTE_ADDR" ;;
    esac
    ;;
  *) printf '{"ip":""}\n' ;;
esac
